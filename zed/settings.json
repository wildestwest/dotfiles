// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "unified",
  "show_edit_predictions": false,
  "show_signature_help_after_edits": true,
  "ui_font_size": 16.0,
  "ui_font_family": "Iosevka Term",
  "lsp_results_location": "picker",
  "autoscroll_on_clicks": true,
  "auto_signature_help": true,
  "project_panel": {
    "dock": "left",
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com"
            }
          ]
        },
        "search_web": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^head\\b"
            },
            {
              "pattern": "^find\\s+/(\\s|$)"
            },
            {
              "pattern": "^pip\\s+show(\\s|$)"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^pip\\s+index(\\s|$)"
            },
            {
              "pattern": "^ls\\b"
            },
            {
              "pattern": "^sed\\b"
            },
            {
              "pattern": "^source\\s+\\.venv/bin/activate(\\s|$)"
            },
            {
              "pattern": "^python\\b"
            }
          ]
        }
      }
    },
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "claude-opus-5-5",
      "enable_thinking": true
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "vim_mode": true,
  "use_smartcase_search": true,
  "title_bar": {
    "show_branch_status_icon": false,
    "show_branch_name": true,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_menus": false,
    "button_layout": "platform_default",
  },
  "vim": {
    "use_system_clipboard": "on_yank",
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
    "highlight_on_yank_duration": 600,
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "python-requirements": true,
    "fastapi-snippets": true,
    "markdown-snippets": true,
    "helm": true,
    "ansible": true,
    "python-snippets": true,
    "rose-pine-theme": true,
  },
  // "disable_ai": true,
  "document_symbols": "on",
  "wrap_guides": [80, 120],
  "cursor_blink": false,
  "buffer_font_family": "Iosevka Term",
  "buffer_font_size": 16,
  "vertical_scroll_margin": 8,
  "which_key": {
    "enabled": true,
  },
  "colorize_brackets": true,
  "inlay_hints": {
    "enabled": true,
  },
  "use_autoclose": false,
  "active_pane_modifiers": {
    "inactive_opacity": 0.6,
  },
  "restore_on_startup": "last_workspace",
  "theme": {
    "mode": "system",
    "light": "Rosé Pine Moon",
    "dark": "Rosé Pine",
  },
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "file_types": {
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
      "**/values*.yaml",
    ],
  },
  "format_on_save": "off",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "status_bar": {
    "experimental.show": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false,
  },
  "outline_panel": {
    "dock": "right",
  },
  "terminal": {
    "dock": "right",
    "default_width": 300,
    "cursor_shape": "block",
    "copy_on_select": true,
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "languages": {
    "Python": {
      "language_servers": [
        // Enable ty, disable basedpyright, and enable all
        // other registered language servers (ruff, pylsp, pyright).
        "ty",
        "!basedpyright",
        "..."
      ]
    },
    "YAML": {
      // yaml ls messes with helm charts
      "language_servers": ["!yaml-language-server", "..."],
    },
  },
  "lsp": {
    "ty": {
      "settings": {
        "completions":{
          "completeFunctionParentheses": true
        }
      }
    }
  }
}

